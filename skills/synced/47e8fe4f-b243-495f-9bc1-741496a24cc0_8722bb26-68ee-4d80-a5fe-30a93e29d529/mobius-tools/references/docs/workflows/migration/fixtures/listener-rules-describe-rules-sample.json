{
  "Rules": [
    {
      "RuleArn": "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener-rule/app/api-alb/abc123/def456/rule1",
      "Priority": "1",
      "Conditions": [
        {
          "Field": "host-header",
          "Values": ["api.example.com", "www.api.example.com"],
          "HostHeaderConfig": {
            "Values": ["api.example.com", "www.api.example.com"]
          }
        },
        {
          "Field": "path-pattern",
          "Values": ["/api/v1/*"],
          "PathPatternConfig": {
            "Values": ["/api/v1/*"]
          }
        }
      ],
      "Actions": [
        {
          "Type": "forward",
          "TargetGroupArn": "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/api-node-payments/abc123",
          "Order": 1
        }
      ],
      "IsDefault": false
    },
    {
      "RuleArn": "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener-rule/app/api-alb/abc123/def456/rule2",
      "Priority": "2",
      "Conditions": [
        {
          "Field": "host-header",
          "Values": ["old.example.com"],
          "HostHeaderConfig": {
            "Values": ["old.example.com"]
          }
        }
      ],
      "Actions": [
        {
          "Type": "redirect",
          "RedirectConfig": {
            "Protocol": "HTTPS",
            "Port": "443",
            "Host": "new.example.com",
            "Path": "/#{path}",
            "Query": "#{query}",
            "StatusCode": "HTTP_301"
          },
          "Order": 1
        }
      ],
      "IsDefault": false
    },
    {
      "RuleArn": "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener-rule/app/api-alb/abc123/def456/rule3",
