      "Actions": [
        {
          "Type": "forward",
          "TargetGroupArn": "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/api-node-payments/abc123",
          "Order": 1
        }
      ],
      "IsDefault": false
